# Public API URL Configuration
# Set this to your domain when deployed to production
# For local development, leave it commented out or empty
# Examples:
#   PUBLIC_API_URL=https://api.yourdomain.com
#   PUBLIC_API_URL=https://pulsepoint.myrfid.nc

# Uncomment and set your domain when deploying:
PUBLIC_API_URL=https://yourdomain.com
